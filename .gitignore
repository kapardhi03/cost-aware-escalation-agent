.claude

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets — never commit real keys. .env.example (placeholders only) is allowed.
.env
.env.*
!.env.example

# Generated belief cache is run output, not source.
# Comment this out if the exact cache behind the reported numbers should ship.
when-to-escalate/data/belief_cache_DRY.json

# Dry-run output is never reportable and must not be committed.
when-to-escalate/results/run_DRY.*
when-to-escalate/results/logprob-elicitation_DRY.*
when-to-escalate/data/logprob_cache_DRY.json

.venv

# LaTeX build output. Regenerated by any compile, so it is never source.
*.pdf
*.aux
*.log

# ...except a figure the paper \includegraphics, which is an INPUT to the compile,
# not an output of it. `*.pdf` above was silently ignoring
# paper/figures/reliability-needs-human.pdf, so main.tex could not compile from a
# fresh clone: the file is generated by make_figures.py, which needs matplotlib,
# which nothing else here depends on. Committing the rendered figure is the fix.
!when-to-escalate/paper/figures/*.pdf

# The PNG beside it is a byproduct. `make_figures.py` writes both extensions from
# one `savefig` loop, LaTeX includes only the PDF, and nothing else reads the PNG,
# so it is an output with no consumer. Ignored so it stops reading as untracked
# work. Only the PNG: the un-ignore above is what the compile depends on.
when-to-escalate/paper/figures/*.png

# macOS Finder metadata. Never source, and easy to sweep in with `git add -A`.
.DS_Store

# Root-level scratch figures only. The mid-pattern separator anchors this to the
# repository root, so it does NOT reach when-to-escalate/paper/figures/ — do not
# "fix" it to **/figures/*, which would re-ignore the figure the paper needs.
figures/*

# Local authoring aids that live in the tree but are not part of the research
# record. Ignored as a directory so anything added beside them is covered too.
when-to-escalate/skill/
